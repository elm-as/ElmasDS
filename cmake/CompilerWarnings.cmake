function(elmasds_apply_warnings target_name)
    if(MSVC)
        target_compile_options(
            "${target_name}"
            PRIVATE
                /W4
                /permissive-
                /Zc:__cplusplus
                /utf-8
                $<$<BOOL:${ELMASDS_WARNINGS_AS_ERRORS}>:/WX>
        )
    else()
        target_compile_options(
            "${target_name}"
            PRIVATE
                -Wall
                -Wextra
                -Wpedantic
                -Wconversion
                -Wsign-conversion
                $<$<BOOL:${ELMASDS_WARNINGS_AS_ERRORS}>:-Werror>
        )
    endif()
endfunction()
